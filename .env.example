# Скопируй в .env и заполни. Реальные значения в репозиторий не попадают (D-009).
SWAGCOD_API_KEY=
SWAGCOD_BASE_URL=https://rustvy.xyz/v1
# Бесплатная модель для стресс-тестов стрима и CI (D-012)
SWAGCOD_MODEL=fable-ultra-promax
# B-6: fallback-цепочка. Точки через ';', поля через '|': url|key|model.
# key пустой — локальный эндпоинт без авторизации (Ollama, llama.cpp);
# model задан — запрос уходит с этой моделью. Порядок = приоритет.
# Пример: облако, потом локальная Ollama.
# SWAGCOD_FALLBACKS=http://localhost:11434/v1||qwen2.5-coder:7b;https://backup.xyz/v1|sk-xxx|deepseek-chat
# Модель-суммаризатор для сжатия контекста (B-3); пусто = модель сессии.
# SWAGCOD_SUMMARIZER_MODEL=
# B-7: ключ можно не держать текстом здесь, а положить под DPAPI Windows:
# команда save_protected_key шифрует его под учётной записью (в базе prefs
# лежит только blob). Приоритет: этот env-файл → DPAPI-blob. Если
# SWAGCOD_API_KEY заполнен, DPAPI не используется.
# Ревизия 25: хранилище — better-sqlite3 в Node-sidecar (sidecar/).
# SWAGCOD_STORE: auto (default, sidecar + фолбэк на встроенный rusqlite),
# node (только sidecar, без тихого фолбэка), sqlite (только встроенный).
# SWAGCOD_STORE=<не задан>
# SWAGCOD_NODE=node
# SWAGCOD_STORE_SIDECAR=<путь к store-server.js, если не рядом с exe>
# E-2: модель эмбеддингов для семантического поиска (инструмент
# semantic_search). Облако по умолчанию; локальные серверы переопределяют
# своей моделью (Ollama: nomic-embed-text и т.п.).
# SWAGCOD_EMBEDDINGS_MODEL=text-embedding-3-small
# E-2: источник эмбеддингов — auto (облако, при 404 громкий фолбэк на
# встроенный лексический), cloud (только облако), local (только
# лексический, сеть не нужна).
# SWAGCOD_EMBEDDINGS_MODE=auto
# E-2: путь базы кэша эмбеддингов (по умолчанию
# %LOCALAPPDATA%\SwagCod\embeddings.db — кэш, не доменные данные).
# SWAGCOD_SEMANTIC_DB=
# E-3: таймаут вызова инструмента MCP-сервера в миллисекундах (по
# умолчанию 60000). Рукопожатие и tools/list — фиксированные 15 с.
# SWAGCOD_MCP_TIMEOUT_MS=60000
# E-4: JS-плагины — каталог plugins/*.js (по умолчанию `plugins` рядом с
# exe или от cwd вверх) и дедлайн вызова handler в vm (по умолчанию
# 30000 мс, диапазон 50..300000).
# SWAGCOD_PLUGINS_DIR=
# SWAGCOD_JS_TIMEOUT_MS=30000
# E-5: период опроса воркера фоновых задач в миллисекундах (по умолчанию
# 15000, диапазон 1000..3600000). Ретраи — экспоненциальный backoff
# 30 с → 30 мин, до 5 попыток; виды задач: semantic_reindex, git_fetch,
# journal_export.
# SWAGCOD_TASKS_POLL_MS=15000
# E-6: лимиты ветки суб-агента — раунды (1..12, дефолт 6) и бюджет
# оценочных токенов ветки (1000..10000000, дефолт 100000). Аргументы
# вызова max_rounds/budget_tokens сильнее env.
# SWAGCOD_SUBAGENT_MAX_ROUNDS=6
# SWAGCOD_SUBAGENT_BUDGET_TOKENS=100000
# E-7: локальный HTTP API (только 127.0.0.1, Bearer-токен под DPAPI).
# По умолчанию ВЫКЛЮЧЕН: задайте порт здесь или prefs-ключом
# http_api_port и перезапустите приложение. Токен генерируется сам
# (32 байта CSPRNG) и показывается в Настройки → Безопасность.
# Маршруты: GET /health (без токена), GET /v1/diagnostics,
# GET /v1/sessions, POST /v1/turns, POST /v1/approvals,
# GET /v1/events (SSE-поток шины).
# SWAGCOD_HTTP_PORT=47479

