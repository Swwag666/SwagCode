# Секреты (D-009): ключ живёт только здесь, в репозиторий не попадает.
.env
.env.local
!.env.example

# Собранный exe и отладочные символы: воспроизводятся сборкой, не хранятся.
SwagCod.exe
*.pdb

# Rust
target/
**/*.rs.bk

# Node / фронтенд
node_modules/
apps/desktop/dist/
apps/desktop/.svelte-kit/
apps/desktop/build/
# F-11: coverage-отчёт — артефакт CI, воспроизводится прогоном тестов.
apps/desktop/coverage/

# Python (F-9: адаптер SwagCod Phone и его тесты живут в tools/phone/)
__pycache__/
*.pyc
.vite/

# E-1: упаковочный вендор — node.exe и плоский sidecar. Тяжёлое,
# воспроизводится скриптами tools/fetch-node.ps1 + tools/bundle-sidecar.ps1.
vendor/

# Релизные артефакты (rev37): setup.exe, .sig, latest.json. Собираются
# tools/build-release.ps1 и уезжают в GitHub Releases, не в репозиторий.
releases/

# Tauri
crates/app/gen/schemas/

# Замеры и артефакты: двоичный шум, воспроизводится скриптами и пробами.
# Числа бюджета — источник правды для README, поэтому startup.json в коммите.
bench-out/*
!bench-out/startup.json
*.tmp
.tmp-*
flamegraph.svg
perf.data

# Локальные помощники: voidsearch — внешний инструмент веб-поиска, живёт на
# диске, но в репозиторий не ездит (решение от ревизии 7).
voidsearch/

# ОС / редакторы
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
