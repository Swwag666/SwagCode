{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SwagCod",
  "version": "0.2.0",
  "identifier": "xyz.swagcod.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../../apps/desktop dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir ../../apps/desktop build",
    "frontendDist": "../../apps/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "title": "SwagCod",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../../vendor/node/node.exe": "node.exe",
      "../../vendor/sidecar": "sidecar"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Swwag666/SwagCode/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0MEQ3NEFDMUNCODc1NTIKUldSU2RiZ2NySFFOWlAvWE90dUhFV2d0QUczYjUxdmUzOVhnSVRCUlF1SVcyQS9PdVVMZW1ZdnQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
